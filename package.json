{
  "name": "wikiyugioh",
  "version": "1.0.0",
  "description": "Proyecto de uni materia PDPW",
  "author": "Grupo1",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "NODE_ENV=development node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "lint": "eslint .",
    "verificar": "npm run lint && npm test"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/"
    ]
  },
  "dependencies": {
    "@types/jest": "^30.0.0",
    "ajv": "^8.20.0",
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "node": "^22.23.3"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "globals": "^16.3.0",
    "jest": "^30.0.4"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true,
    "node@22.23.4": true
  }
}
